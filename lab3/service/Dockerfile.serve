# ITCS355 Lab 3 — serving image
#
# Pinned by digest, exactly as the training image is. Same digest, so the serving runtime
# and the training runtime are provably the same base bytes — one fewer difference to
# explain when a model behaves differently in production than it did in training.
FROM python@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534 AS builder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /build
COPY requirements-serve.txt ./
RUN pip install --require-hashes --prefix=/install -r requirements-serve.txt

FROM python@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534 AS runtime
RUN useradd --create-home --uid 10001 runner
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app
COPY --from=builder /install /usr/local
WORKDIR /app
COPY --chown=runner:runner service/ ./service/
COPY --chown=runner:runner src/ ./src/
COPY --chown=runner:runner cloudlayer/ ./cloudlayer/
USER runner

EXPOSE 8080

# Route paths differ per provider — SageMaker wants /ping and /invocations, Azure ML wants
# a liveness route named on the deployment, Vertex AI wants both routes declared on the
# Model resource. None of that appears here or in service/app.py. It lives in
# cloudlayer.routes.ROUTES_BY_PROVIDER, which deploy() reads when it registers the model,
# so this one image is deployable on all three without a rebuild.
#
# Worker count is the instance-size lever, measured in reports/lab3-load.md: one worker
# saturates at 44 requests per second, four at 225, eight at 354. Two is the default
# because the smallest instance worth deploying has two vCPUs; override it per instance.
ENV UVICORN_WORKERS=2
CMD ["sh", "-c", "uvicorn service.app:app --host 0.0.0.0 --port 8080 --workers ${UVICORN_WORKERS}"]
