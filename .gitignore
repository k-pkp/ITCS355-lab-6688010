# NEVER commit this. Real credentials and account identifiers live here.
cloud.env

# DVC manages these; Git must not.
data/raw/
data/_local_blob/
.dvc/cache/

# Local tracking store
mlruns/
mlartifacts/
mlflow.db

reports/*.json
reports/*.joblib
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Excel lock files — created while the specification workbook is open.
~$*

# ruff cache
.ruff_cache/

# Drift exercise inputs — generated by scripts/inject_drift.py, derived from data/raw.
data/current*.csv

# Transient: the pipeline gate writes its decision here for the conditional step to read.
reports/gate_decision.txt

# Local study notes (one PDF per lab). Never pushed.
# Anchored with a leading slash on purpose: every lab folder has its own committed docs/
# (the post-mortem template, the repo guide), and a bare `docs/` would ignore those too.
/docs/
